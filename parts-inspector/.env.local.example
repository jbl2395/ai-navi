# ============================================================
#  Jev API (Type Safe AI) 接続設定
#  このファイルを .env.local にコピーして値を設定してください。
#    cp .env.local.example .env.local
# ============================================================

# Jev API キー。
# 未設定の場合、アプリは自動的にモックモードで動作します
# （疑似的な判定レスポンスを返すため、実機・UI の動作確認が可能）。
JEV_API_KEY=

# Jev API のエンドポイント（分類 / Classification）
JEV_API_URL=https://api.typesafeai.com/v1/classify

# 使用する分類モデル ID
JEV_MODEL=jev-fast-classifier-v1

# 判定しきい値（0.0 - 1.0）
# PASS 確率がこの値以上 → PASS
JEV_PASS_THRESHOLD=0.90
# FAIL 確率がこの値以上 → FAIL（PASS 判定より優先）
JEV_FAIL_THRESHOLD=0.60

# API 呼び出しのタイムアウト（ミリ秒）
JEV_TIMEOUT_MS=5000

# 強制的にモックを使う場合は 1 を設定（API キーがあってもモックになります）
JEV_FORCE_MOCK=0
